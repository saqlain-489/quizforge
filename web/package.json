{
  "name": "quizforge-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static viewer for a quizforge run: take the quiz, see how each question was made.",
  "license": "MIT",
  "author": "Saqlain Ahmad",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "sync-data": "node --import tsx scripts/sync-data.mjs",
    "predev": "npm run sync-data",
    "dev": "next dev",
    "prebuild": "npm run sync-data",
    "build": "next build",
    "pretest": "npm run sync-data",
    "test": "vitest run",
    "typecheck": "npm run sync-data && next typegen && tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "geist": "1.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
