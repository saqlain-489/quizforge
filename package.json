{
  "name": "quizforge",
  "version": "0.1.0",
  "description": "Turn any document into a checked, source-cited quiz with a multi-agent pipeline.",
  "type": "module",
  "license": "MIT",
  "author": "Saqlain Ahmad",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "evals": "node --import tsx evals/run.ts",
    "demo": "node --import tsx src/cli.ts demo",
    "generate": "node --import tsx src/cli.ts generate",
    "mcp": "node --import tsx src/mcp/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mastra/core": "^1.79.0",
    "@mastra/mcp": "^1.18.0",
    "js-yaml": "^5.5.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
